# Copy to .env and fill in. NEVER put your main wallet here – use a fresh wallet just for the bot.
WALLET_SEED=sXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- money ---
BUY_XRP=1                # XRP per launch
MIN_BALANCE_XRP=10       # free XRP that is never spent on buys
MAX_OPEN=25              # open positions at once (each trust line locks 0.2 XRP until sold)
MAX_BUYS_PER_DAY=40

# --- which launches ---
MIN_POOL_XRP=20          # skip pools with less XRP at the start
MAX_POOL_XRP=0           # 0 = no upper limit
REQUIRE_BLACKHOLE=1      # only tokens whose issuer can no longer mint
BLACKHOLE_WAIT_S=120     # how long to wait for the blackhole after the pool appears
MIN_POOL_SUPPLY_PCT=20   # at least this share of all tokens must sit in the pool
MAX_TRANSFER_FEE=0       # percent
MAX_AMM_FEE=1            # percent

# --- selling ---
TAKE_PROFIT=100          # +100 % → sell part of the bag
TAKE_PROFIT_PART=50      # that part, in percent
TRAILING_STOP=30         # after that: sell the rest 30 % below the best value
STOP_LOSS=50             # before that: sell everything at −50 %
RUG_POOL_DROP=40         # pool XRP 40 % below our entry → sell everything at once
MAX_HOLD_H=24            # sell whatever is left after 24 h
BUY_SLIPPAGE=25
SELL_SLIPPAGE=30

# --- extras ---
DRY_RUN=0                # 1 = only pretend
PORT=3100                # status page (leave empty = off)
STATUS_KEY=change-me     # status page: http://host:3100/?key=change-me
DISCORD_WEBHOOK=         # optional: every buy/sell as a Discord message
# DATA_DIR=/home/you/xrpl-sniper-data
# XRPL_WS=wss://xrplcluster.com,wss://s1.ripple.com,wss://s2.ripple.com
