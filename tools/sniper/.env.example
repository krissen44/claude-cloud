# Copy to .env and fill in. NEVER put your main wallet here – use a fresh wallet just for the bot.
WALLET_SEED=sXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- money ---
BUY_XRP=1                # XRP per launch
MIN_BALANCE_XRP=10       # free XRP that is never spent on buys
MAX_OPEN=25              # trades whose stake is not back yet (moonbags don't count; each trust line locks 0.2 XRP)
MAX_BUYS_PER_DAY=40

# --- which launches ---
MIN_POOL_XRP=100         # only buy when the pool holds at least this much XRP
POOL_WAIT_MIN=10         # a smaller launch is watched this long and bought once it passes MIN_POOL_XRP (0 = skip at once)
MAX_POOL_XRP=0           # 0 = no upper limit
REQUIRE_BLACKHOLE=1      # only tokens whose issuer can no longer mint
BLACKHOLE_WAIT_S=120     # how long to wait for the blackhole after the pool appears
MIN_POOL_SUPPLY_PCT=20   # at least this share of all tokens must sit in the pool
MAX_TRANSFER_FEE=0       # percent
MAX_AMM_FEE=1            # percent

# --- selling ---
TAKE_PROFIT=100          # at +100 % the first (and only) sale happens
TAKE_PROFIT_PART=auto    # auto = sell just enough to get the stake back (+RECOVER_BUFFER), the rest rides free forever
RECOVER_BUFFER=5         # percent on top of the stake (fees + trust line)
TRAILING_STOP=0          # 0 = the moonbag is never sold; e.g. 50 = sell the rest 50 % below its peak
DEAD_POOL_DROP=90        # moonbag is cleared only when its pool lost 90 % of its XRP (frees 0.2 XRP reserve)
# before the stake is back (0 = off):
STOP_LOSS=50             # sell everything at −50 %
RUG_POOL_DROP=40         # pool XRP 40 % below our entry → sell everything at once
MAX_HOLD_H=24            # stake still not back after 24 h → sell

# --- wallet tracking (copy buys) ---
TRACK_WALLETS=           # rAddress:Name,rAddress2:Name2 – buy what these wallets buy
COPY_BUY_XRP=1           # XRP per copied buy
COPY_MIN_XRP=5           # ignore their buys below this many XRP
COPY_MIN_POOL_XRP=100    # same liquidity rule for copied tokens
# copied buys sell by their own rules (no moonbag):
COPY_TAKE_PROFIT=100     # at +100 % …
COPY_TAKE_PROFIT_PART=50 # … sell half
COPY_TRAILING_STOP=30    # then sell the rest 30 % below its peak
COPY_STOP_LOSS=50        # before that: everything at −50 %
COPY_RUG_POOL_DROP=40    # pool XRP 40 % below entry → everything at once
COPY_MAX_HOLD_H=24       # after 24 h whatever is left is sold
BUY_SLIPPAGE=25
SELL_SLIPPAGE=30

# --- approval for big tokens ---
MCAP_APPROVAL=100000     # sells of a token with at least this market cap wait for your OK (0 = off); rugs stay automatic
MCAP_CURRENCY=USD        # USD (price from the XRP/RLUSD pool on the ledger) or XRP
XRP_USD=                 # fallback XRP price in USD if the pool can't be read (empty = ask anyway)
PUBLIC_URL=              # address of the status page, e.g. http://123.45.67.89:3100 – used in the Discord message

# --- extras ---
DRY_RUN=0                # 1 = only pretend
PORT=3100                # status page (leave empty = off)
STATUS_KEY=change-me     # status page: http://host:3100/?key=change-me – REQUIRED for the approve/sell buttons
DISCORD_WEBHOOK=         # optional: every buy/sell as a Discord message
# DATA_DIR=/home/you/xrpl-sniper-data
# XRPL_WS=wss://xrplcluster.com,wss://s1.ripple.com,wss://s2.ripple.com
